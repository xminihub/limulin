{
  "name": "limulin",
  "version": "0.3.3",
  "description": "limulin — a tui for dsh and others",
  "keywords": [
    "tui",
    "terminal",
    "dsh",
    "bun"
  ],
  "license": "MIT",
  "author": "sheltonsuen",
  "homepage": "https://github.com/xminihub/limulin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xminihub/limulin.git"
  },
  "bugs": {
    "url": "https://github.com/xminihub/limulin/issues"
  },
  "bin": {
    "lim": "./dist/lim.js"
  },
  "main": "dist/lim.js",
  "module": "dist/lim.js",
  "exports": {
    ".": "./dist/lim.js"
  },
  "files": [
    "dist/lim.js",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:binaries": "bash scripts/build-binaries.sh",
    "test": "bun test",
    "typecheck": "bun check",
    "fmt": "bun fmt",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.8.4",
    "@opentui/keymap": "^0.8.4",
    "@opentui/react": "^0.8.4",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
